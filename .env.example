DOSTRA_API_PORT=8000
DOSTRA_WEB_PORT=5173

# Compose-level defaults for the API container.
DOSTRA_API_APP_ENV=local
DOSTRA_API_APP_DEBUG=true
DOSTRA_API_APP_URL=http://127.0.0.1:8000
DOSTRA_API_DB_CONNECTION=sqlite
DOSTRA_API_DB_DATABASE=database/database.sqlite

# Compose-level defaults for the frontend container.
DOSTRA_WEB_VITE_API_BASE_URL=http://127.0.0.1:8000/api
