# Production environment variables for the Dostra CRM stack.
#
# Copy this file to .env.prod and fill in real values before deploying.
# .env.prod must never be committed to version control.
#
# Usage:
#   cp .env.prod.example .env.prod
#   # fill in values
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
# Used by both the db service (to initialise the database) and the api service
# (to connect to it). Keep these three in sync.

POSTGRES_DB=dostra
POSTGRES_USER=dostra
POSTGRES_PASSWORD=change_me_strong_password

# ── Laravel ─────────────────────────────────────────────────────────────────────
# APP_KEY must be a valid base64-encoded 32-byte key.
# Generate one with: php artisan key:generate --show

APP_KEY=base64:replace_with_output_of_key_generate
APP_URL=https://yourdomain.com

# ── Frontend ─────────────────────────────────────────────────────────────────────
# Baked into the JS bundle at build time by Vite.
# Must be the public-facing URL browsers use to reach the API.

VITE_API_BASE_URL=https://yourdomain.com/api
